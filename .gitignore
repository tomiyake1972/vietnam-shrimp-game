# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Phase SAI-3A: 標準AI自動テストプレイの大量実行生成物（artifacts/sai3a/<run-id>/以下）。
# 小さなサンプルfixtureのみ、明示的にgit addして例外的にコミットする
# （例: docs/v2/sai3a/fixtures/配下）。
/artifacts/sai3a/

# Phase SAI-3B-1: Excel経営分析ブック生成物（artifacts/sai3b/以下）。
# 大量の生成.xlsxはGit管理対象にしない（三宅さんの指示§7）。
/artifacts/sai3b/

# Phase SAI-4: 標準AI異質5社テスト・養殖上限4,000トン試験の生成物
# （artifacts/sai4/以下）。同じ理由でGit管理対象にしない。
/artifacts/sai4/

# Phase SAI-5: 市場進化モデル（A/B比較・因果トレース）の生成物
# （artifacts/sai5/以下）。同じ理由でGit管理対象にしない
# （生成スクリプト scripts/sai5Analysis.ts のみGit管理する）。
/artifacts/sai5/

# 加工品市場進化の検証シナリオ生成物（診断専用、artifacts/market-evolution/以下）。
# 大量のCSV/JSON生成物はGit管理対象にしない
# （生成スクリプト scripts/processedMarketEvolutionScenarios.ts のみGit管理する）。
/artifacts/market-evolution/

# PD省人化の比較シミュレーション生成物（診断専用）。
# 生成スクリプト scripts/pdMechanizationComparison.ts のみGit管理する。
/artifacts/pd-mechanization/

# SAI-3A 標準初期条件の再選定グリッド探索の生成物（診断専用）。
# 生成スクリプト scripts/sai3aBaselineGridSearch.ts のみGit管理する。
/artifacts/sai3a-baseline/

# PD価値ベース価格モデルの数値プロトタイプ生成物（診断専用）。
# 生成スクリプト scripts/pdValueBasedPricingPrototype.ts のみGit管理する。
/artifacts/pd-value-pricing/
