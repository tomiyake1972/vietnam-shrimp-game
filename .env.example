# このファイルは環境変数の一覧サンプルです。実際の値（本物のURL・トークン）は
# 絶対にコミットしないでください。ローカル開発時は `.env.local` にコピーして使います。

# --- 環境判定 ---
# production / staging / development / preview のいずれか。
# 未設定または不明な値の場合は安全側（非production）として扱われます。
# サーバー側の判定にのみ使用し、クライアントには公開しません（NEXT_PUBLIC_*は使用しません）。
APP_ENV=development

# --- 本番用 Upstash Redis（isProduction時のみ使用） ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- ステージング/開発/プレビュー用 Upstash Redis（isProduction以外で使用） ---
# 本番とは必ず別のRedisデータベースを用意してください（環境分離の一次防御）。
STAGING_KV_REST_API_URL=
STAGING_KV_REST_API_TOKEN=

# --- テストゲーム管理API（Step 5）の管理者トークン ---
# /api/game/[gameCode]/admin/* および snapshots の作成・復元・削除に必要です。
# 本番環境ではこのトークンが設定されていても管理操作自体が無効化されます。
# 十分に長いランダム文字列を使用し、リポジトリには絶対にコミットしないでください。
STAGING_ADMIN_TOKEN=
